# Server
PORT=3000

# MongoDB Atlas (SRV connection string — never commit real values)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/drift?retryWrites=true&w=majority
MONGODB_DB=drift

# Auth0 (from shared/auth0-setup.md)
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_AUDIENCE=https://api.drift.local

# Google Places (Person 1)
GOOGLE_PLACES_API_KEY=
