# API (Person 1 backend). Production build uses same-origin "" unless you override this.
VITE_API_BASE_URL=http://localhost:3000

# Auth0 (from shared/auth0-setup.md — never commit real secrets if any)
VITE_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.drift.local

# Google Maps JS SDK
VITE_GOOGLE_MAPS_API_KEY=

# Seeded group — leave blank unless you are already a member of that Atlas group.
# A stale id 404s. Create a group from Profile after login instead.
VITE_DEMO_GROUP_ID=

# Carto basemap (free key from https://carto.com/basemaps/apikey — put real key only in frontend/.env)
VITE_CARTO_API_KEY=
# voyager | positron | dark_matter  (positron = softest light look)
VITE_CARTO_STYLE=positron
